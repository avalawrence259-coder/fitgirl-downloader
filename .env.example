# ==============================================================================
# FitGirl Downloader & Accelerator — Optional Cloud API Keys (.env.example)
# ==============================================================================
# NOTE: NO API KEYS ARE REQUIRED for normal daily use!
# The CLI uses local Playwright and pure Python cryptography to solve challenges
# and decrypt PrivateBin links 100% free with zero configuration.
#
# Only configure these if you are running on a headless VPS without Chromium
# or if your ISP has heavy geoblocking/censorship against FitGirl/Cloudflare:
# ==============================================================================

# 1. Firecrawl Cloud Scraper (Optional - 500 free scrapes/mo at https://firecrawl.dev)
FIRECRAWL_API_KEY=

# 2. Scrapfly Cloud Scraper (Optional - 1,000 free requests/mo at https://scrapfly.io)
SCRAPFLY_API_KEY=

# 3. ZenRows Web Scraper API (Optional - 1,000 free requests/mo at https://zenrows.com)
ZENROWS_API_KEY=

# 4. ScraperAPI (Optional - 5,000 free requests/mo at https://scraperapi.com)
SCRAPERAPI_KEY=
